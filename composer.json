{
    "name": "arzcode/laravel-ticktick",
    "description": "A Laravel package to connect to TickTick API and manage tasks",
    "keywords": [
        "ticktick",
        "laravel",
        "api",
        "task management",
        "productivity"
    ],
    "homepage": "https://github.com/buzkall/laravel-ticktick",
    "license": "MIT",
    "authors": [
        {
            "name": "arzcode",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/buzkall/laravel-ticktick/issues",
        "source": "https://github.com/buzkall/laravel-ticktick"
    },
    "require": {
        "php": "^8.4",
        "guzzlehttp/guzzle": "^7.5",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "laravel/framework": "13.*",
        "laravel/pint": "^1.0",
        "mockery/mockery": "^1.5",
        "orchestra/testbench": "11.*",
        "pestphp/pest": "^4.0|^5.0",
        "pestphp/pest-plugin-laravel": "^4.0|^5.0"
    },
    "autoload": {
        "psr-4": {
            "Arzcode\\TickTick\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Arzcode\\TickTick\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint",
        "format-check": "vendor/bin/pint --test"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Arzcode\\TickTick\\TickTickServiceProvider"
            ],
            "aliases": {
                "TickTick": "Arzcode\\TickTick\\Facades\\TickTick"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
